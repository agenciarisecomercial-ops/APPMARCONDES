rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function access() { return request.auth != null; }
  function count(v) { return v == null || (v is int && v >= 0 && v <= 1000000000000); }
  function date(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
  function valid(area, id) {
   let d = request.resource.data;
   let common = ['id','title','note','rev'];
   return d.id == id && d.id is string && d.id.size() <= 100
    && d.title is string && d.title.size() > 0 && d.title.size() <= 120
    && d.note is string && d.note.size() <= 5000 && d.rev is int && d.rev > 0
    && ((area == 'dates' && d.keys().hasOnly(common.concat(['date','kind','alert','excluded']))
      && date(d.date) && d.kind in ['Evento','Comemorativa']
      && d.alert in [-1,0,1,3,7,14,30] && d.excluded is bool)
    || (area == 'ideas' && d.keys().hasOnly(common.concat(['status','link']))
      && d.status in ['Ideia','Em produção','Publicado'] && d.link is string && d.link.size() <= 2000
      && (d.link == '' || d.link.matches('^https?://.*')))
    || (area == 'reports' && d.keys().hasOnly(common.concat(['start','end','spend','reach','impressions','views','clicks','acquisitions','followers']))
      && date(d.start) && date(d.end) && d.end >= d.start
      && d.spend is number && d.spend >= 0 && d.spend <= 1000000000000
      && count(d.reach) && count(d.impressions) && count(d.views)
      && count(d.clicks) && count(d.acquisitions) && count(d.followers)));
  }
  // Acesso compartilhado por link, com sessão automática. Não usar para dados privados.
  match /workspaces/marcondes/{area}/{id} {
   allow read: if access() && area in ['dates','ideas','reports'];
   allow create: if access() && valid(area,id) && request.resource.data.rev == 1;
   allow update: if access() && valid(area,id) && request.resource.data.rev == resource.data.rev + 1;
   allow delete: if access() && area in ['dates','ideas','reports'];
  }
 }
}
